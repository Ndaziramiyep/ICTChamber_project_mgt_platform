# Copy this file to `.env.test` for running the automated test suite locally.
# Tests connect to a REAL MongoDB instance (no mocks) using a dedicated database
# that is dropped and rebuilt between test runs.

APPLICATION_ENVIRONMENT_NAME=test

MONGODB_CONNECTION_URI=mongodb://localhost:27017
MONGODB_DATABASE_NAME=ictchamber_kanban_test

JWT_SECRET_KEY=test-only-secret-value-not-for-production
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

ALLOWED_CORS_ORIGINS=http://localhost:3000
