# Copy this file to `.env` and fill in real values for local development.

APPLICATION_ENVIRONMENT_NAME=development

# MongoDB connection used by the running application (not the test suite).
MONGODB_CONNECTION_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DATABASE_NAME=ictchamber_kanban

# Secret used to sign JWT access and refresh tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-value
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Comma-separated list of origins allowed to call this API from a browser (the future frontend).
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
